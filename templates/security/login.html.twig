{% extends 'security/base-logout.html.twig' %}

{% block title %}Connexion - TaskLinker{% endblock %}

{% block body %}
<header>
   <div id="current-user">
    {{ include('_current_user.html.twig') }}
</div>

    <div id="title-page">
        <h1>Connexion</h1>
    </div>
</header>

<div id="content">
    {% if error %}
        <div class="alert alert-danger">
            Identifiants invalides.
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div>
            <label for="inputEmail">E-mail</label>
            <input
                type="email"
                value="{{ last_username }}"
                name="email"
                id="inputEmail"
                required
                autofocus
            />
        </div>

        <div>
            <label for="inputPassword">Mot de passe</label>
            <input
                type="password"
                name="password"
                id="inputPassword"
                required
            />
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <br>
        <button class="button button-submit" type="submit">Se connecter</button>
    </form>
</div>
{% endblock %}
