{# templates/security/base-logout.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}TaskLinker{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {# CSS du prototype #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}"/>

    {# Icônes (prototype) #}
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
    />

    {# jQuery + Select2 (prototype) #}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link
        href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
        rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    {# JS custom (prototype) #}
    <script src="{{ asset('js/select.js') }}"></script>

    {% block stylesheets %}{% endblock %}
</head>

<body>
<div id="main-container">

    <nav>
        {# Sur les pages logout (login/register), le logo renvoie vers la connexion #}
        <a href="{{ path('app_login') }}" id="logo">
            <img src="{{ asset('img/logo.png') }}" alt="Logo TaskLinker" />
        </a>

        <ul id="main-menu">
            <li class="{{ app.request.attributes.get('_route') == 'app_register' ? 'active' : '' }}">
                <a href="{{ path('app_register') }}">
                    <i class="fa-regular fa-user"></i> Inscription
                </a>
            </li>

            <li class="{{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}">
                <a href="{{ path('app_login') }}">
                    <i class="fa-solid fa-right-to-bracket"></i> Connexion
                </a>
            </li>
        </ul>
    </nav>

    <main>
        {% block body %}{% endblock %}
    </main>

</div>
</body>
</html>
