<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}TaskLinker{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="{{ asset('css/style.css') }}"/>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
    />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="{{ asset('js/select.js') }}"></script>

    {% block stylesheets %}{% endblock %}
</head>

<body>
<div id="main-container">
    <nav>
        <a href="{{ path('app_project_index') }}" id="logo">
            <img src="{{ asset('img/logo.png') }}" alt="Logo TaskLinker" />
        </a>

        {% set route = app.request.attributes.get('_route') %}

        <ul id="main-menu">
            <li class="{{ route starts with 'app_project_' ? 'active' : '' }}">
                <a href="{{ path('app_project_index') }}">
                    <i class="fa-solid fa-list-check"></i> Projets
                </a>
            </li>

            {# 🔒 ÉQUIPE : UNIQUEMENT POUR LES MANAGERS #}
            {% if is_granted('ROLE_MANAGER') %}
                <li class="{{ route starts with 'app_team_' ? 'active' : '' }}">
                    <a href="{{ path('app_team_index') }}">
                        <i class="fa-regular fa-user"></i> Équipe
                    </a>
                </li>
            {% endif %}
        </ul>
    </nav>

    <main>
        <header>
            <div class="header-bar">

                <div class="header-left">
                    <div id="title-page">
                        <h1>{% block page_title %}{% endblock %}</h1>
                    </div>

                    <div class="header-left-actions">
                        {% block header_actions %}{% endblock %}
                    </div>
                </div>

                <div class="header-right">
                    {% if app.user %}
                        {% set initials =
                            (app.user.firstName|default('')|slice(0,1)|upper)
                            ~
                            (app.user.lastName|default('')|slice(0,1)|upper)
                        %}

                        {% if initials|trim == '' %}
                            {% set initials = app.user.email|slice(0,2)|upper %}
                        {% endif %}

                        <a href="{{ path('app_logout') }}"
                           class="current-user-avatar"
                           title="Se déconnecter">
                            {{ initials }}
                        </a>
                    {% endif %}
                </div>

            </div>
        </header>

        <div id="content">
            {% block body %}{% endblock %}
        </div>
    </main>
</div>
</body>
</html>
