<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}TaskLinker{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {# CSS principal du prototype #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}"/>

    {# Font Awesome (icônes) #}
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
    />

    {# jQuery (utilisé par le prototype / select2) #}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    {# Select2 (pour les formulaires avec select amélioré) #}
    <link
        href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
        rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    {# JS custom #}
    <script src="{{ asset('js/select.js') }}"></script>

    {# Bloc pour CSS spécifique aux pages #}
    {% block stylesheets %}{% endblock %}
</head>

<body>

<div id="main-container">

    {# =======================
       SIDEBAR / NAVIGATION
       ======================= #}
    <nav>
        <a href="{{ path('app_project_index') }}" id="logo">
            <img src="{{ asset('img/logo.png') }}" alt="Logo TaskLinker"/>
        </a>

        <ul id="main-menu">
            <li>
                <a href="{{ path('app_project_index') }}">
                    <i class="fa-solid fa-list-check"></i>
                    Projets
                </a>
            </li>

            <li>
                <a href="{{ path('app_user_index') }}">
                    <i class="fa-regular fa-user"></i>
                    Équipe
                </a>
            </li>
        </ul>
    </nav>

    {# =======================
       CONTENU PRINCIPAL
       ======================= #}
    <main>
        {% block body %}{% endblock %}
    </main>

</div>

</body>
</html>
