{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - TaskLinker{% endblock %}

{# Titre affiché dans le header vert #}
{% block page_title %}
    {{ project.name }}
{% endblock %}

{# AUCUNE action dans le header pour edit #}
{% block header_actions %}{% endblock %}

{% block body %}

    {{ form_start(form) }}

        <div>
            {{ form_label(form.name, 'Titre du projet') }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div>
            {{ form_label(form.users, 'Inviter des membres') }}
            {{ form_widget(form.users) }}
            {{ form_errors(form.users) }}
        </div>

        <button class="button button-submit">
            Modifier
        </button>

    {{ form_end(form) }}

{% endblock %}
