{% extends 'base.html.twig' %}

{% block title %}Liste des projets - TaskLinker{% endblock %}

{% block body %}
    <header>
        <div id="current-user"></div>
        <div id="title-page">
            <h1>Projets</h1>
        </div>
    </header>

    <div id="content">
        <div id="projects-container">

            {# Cartes projets — structure STRICTEMENT identique au prototype #}
            {% for project in projects %}
                <article class="card-project">
                    <a href="{{ path('app_project_show', { id: project.id }) }}">
                        <h2>{{ project.name }}</h2>
                    </a>

                    <div class="card-project-icons">
                        <a href="{{ path('app_project_edit', { id: project.id }) }}">
                            <i class="fa-solid fa-pen"></i>
                        </a>

                        {# Icône poubelle VISUELLE (identique prototype) #}
                        <a href="#"
                           onclick="event.preventDefault(); document.getElementById('delete-form-{{ project.id }}').submit();">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </div>
                </article>

                {# Formulaire caché pour POST (Symfony) — n'affecte PAS le layout #}
                <form id="archive-form-{{ project.id }}"
                      method="post"
                      action="{{ path('app_project_archive', { id: project.id }) }}"
                      style="display:none;">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ project.id) }}">
                </form>
            {% endfor %}

            {# Carte "Ajouter un projet" — IDENTIQUE au prototype #}
            <article class="card-project">
                <a href="{{ path('app_project_new') }}">
                    <i class="fa-solid fa-circle-plus add-project-icon"></i>
                    <h2>Ajouter un projet</h2>
                </a>
            </article>

        </div>
    </div>
{% endblock %}
