{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - TaskLinker{% endblock %}

{% block page_title %}{{ project.name }}{% endblock %}

{# ✅ Bouton Modifier uniquement manager #}
{% block header_actions %}
    {% if is_granted('ROLE_MANAGER') %}
        <a class="button" href="{{ path('app_project_edit', { id: project.id }) }}">Modifier</a>
    {% endif %}
{% endblock %}

{% block body %}

<div id="tasks-container">

    <div class="task-column kanban-column" data-status="todo">
        <h2>To Do</h2>
        <div class="tasks-list">
            {% for task in todo %}
                <a class="task task-card"
                   draggable="true"
                   data-id="{{ task.id }}"
                   href="{{ path('app_project_tasks_show', { projectId: project.id, id: task.id }) }}">
                    <h3>{{ task.title }}</h3>

                    {% if task.description %}
                        <p>{{ task.description }}</p>
                    {% endif %}

                    <div class="task-infos">
                        {% if task.deadline %}
                            <div class="task-deadline">
                                <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                            </div>
                        {% endif %}

                        {% if task.assignee %}
                            <div class="mini-user">
                                {{ task.assignee.firstName|first|upper }}{{ task.assignee.lastName|first|upper }}
                            </div>
                        {% endif %}
                    </div>
                </a>
            {% endfor %}

            {% if is_granted('ROLE_MANAGER') %}
                <a href="{{ path('app_project_tasks_new', { id: project.id }) }}" class="task-add">
                    + Ajouter une tâche
                </a>
            {% endif %}
        </div>
    </div>

    <div class="task-column kanban-column" data-status="doing">
        <h2>Doing</h2>
        <div class="tasks-list">
            {% for task in doing %}
                <a class="task task-card"
                   draggable="true"
                   data-id="{{ task.id }}"
                   href="{{ path('app_project_tasks_show', { projectId: project.id, id: task.id }) }}">
                    <h3>{{ task.title }}</h3>

                    {% if task.description %}
                        <p>{{ task.description }}</p>
                    {% endif %}

                    <div class="task-infos">
                        {% if task.deadline %}
                            <div class="task-deadline">
                                <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                            </div>
                        {% endif %}

                        {% if task.assignee %}
                            <div class="mini-user">
                                {{ task.assignee.firstName|first|upper }}{{ task.assignee.lastName|first|upper }}
                            </div>
                        {% endif %}
                    </div>
                </a>
            {% endfor %}

            {% if is_granted('ROLE_MANAGER') %}
                <a href="{{ path('app_project_tasks_new', { id: project.id }) }}" class="task-add">
                    + Ajouter une tâche
                </a>
            {% endif %}
        </div>
    </div>

    <div class="task-column kanban-column" data-status="done">
        <h2>Done</h2>
        <div class="tasks-list">
            {% for task in done %}
                <a class="task task-card"
                   draggable="true"
                   data-id="{{ task.id }}"
                   href="{{ path('app_project_tasks_show', { projectId: project.id, id: task.id }) }}">
                    <h3>{{ task.title }}</h3>

                    {% if task.description %}
                        <p>{{ task.description }}</p>
                    {% endif %}

                    <div class="task-infos">
                        {% if task.deadline %}
                            <div class="task-deadline">
                                <i class="fa-regular fa-calendar"></i> {{ task.deadline|date('d/m/Y') }}
                            </div>
                        {% endif %}

                        {% if task.assignee %}
                            <div class="mini-user">
                                {{ task.assignee.firstName|first|upper }}{{ task.assignee.lastName|first|upper }}
                            </div>
                        {% endif %}
                    </div>
                </a>
            {% endfor %}

            {% if is_granted('ROLE_MANAGER') %}
                <a href="{{ path('app_project_tasks_new', { id: project.id }) }}" class="task-add">
                    + Ajouter une tâche
                </a>
            {% endif %}
        </div>
    </div>

</div>

{% endblock %}
