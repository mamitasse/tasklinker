{% extends 'base.html.twig' %}

{% block title %}{{ user.fullName }} - TaskLinker{% endblock %}
{% block page_title %}{{ user.fullName }}{% endblock %}

{% block body %}

    {{ form_start(form) }}

        <div>
            {{ form_label(form.lastName) }}
            {{ form_widget(form.lastName) }}
            {{ form_errors(form.lastName) }}
        </div>

        <div>
            {{ form_label(form.firstName) }}
            {{ form_widget(form.firstName) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div>
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-flex">
            <div>
                {{ form_label(form.hiredAt) }}
                {{ form_widget(form.hiredAt) }}
                {{ form_errors(form.hiredAt) }}
            </div>

            <div>
                {{ form_label(form.contractStatus) }}
                {{ form_widget(form.contractStatus) }}
                {{ form_errors(form.contractStatus) }}
            </div>
        </div>

        <button class="button button-submit">Enregistrer</button>

    {{ form_end(form) }}

{% endblock %}
