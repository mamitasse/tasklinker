{% extends 'base.html.twig' %}

{% block title %}Modifier {{ user.fullName }} | Équipe{% endblock %}

{% block body %}
<header>
    <div id="title-page">
        <div class="flex-header">
            <h1>Modifier un employé</h1>
        </div>
    </div>
</header>

<div id="content">
    {{ form_start(form) }}
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
        {{ form_row(form.email) }}

        <button class="button" type="submit">Enregistrer</button>
        <a class="button" href="{{ path('app_user_show', { id: user.id }) }}">Annuler</a>
    {{ form_end(form) }}
</div>
{% endblock %}
