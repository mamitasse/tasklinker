{% extends 'base.html.twig' %}

{% block title %}Liste des employés - TaskLinker{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>
    <div id="title-page">
        <h1>Équipe</h1>
    </div>
</header>

<div id="content">
    <table id="team-container">
        <thead>
            <tr>
                <th>Prénom, Nom</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <div class="employee-infos">
                            <div class="employee-avatar">
                                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                            </div>

                            <div class="employee-coords">
                                <strong>{{ user.firstName }} {{ user.lastName }}</strong>
                                <span>{{ user.email }}</span>
                            </div>
                        </div>
                    </td>

                    <td>{{ user.contractType ?? '' }}</td>

                    <td>
                        <a class="button button-edit-team" href="{{ path('app_user_edit', { id: user.id }) }}">
                            Éditer
                        </a>

                        {# Prototype affiche "Supprimer" mais l'énoncé ne le demande pas #}
                        <a class="delete-team" href="#">
                            Supprimer
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
