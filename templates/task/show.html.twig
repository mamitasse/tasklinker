{% extends 'base.html.twig' %}

{% block title %}{{ task.title }} - TaskLinker{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>

    <div id="title-page">
        <h1>{{ task.title }}</h1>
    </div>
</header>

<div id="content">

    {{ form_start(form) }}

        {{ form_row(form.title, {
            label: 'Titre de la tâche'
        }) }}

        {{ form_row(form.description, {
            label: 'Description'
        }) }}

        <div class="flex-form">
            <div>
                {{ form_row(form.deadline, {
                    label: 'Date'
                }) }}
            </div>

            <div>
                {{ form_row(form.status, {
                    label: 'Statut'
                }) }}
            </div>
        </div>

        {{ form_row(form.assignee, {
            label: 'Membre'
        }) }}

        <br>

        <button class="button button-submit">
            Modifier
        </button>

    {{ form_end(form) }}

    <form method="post"
          action="{{ path('app_project_tasks_delete', {
              projectId: project.id,
              id: task.id
          }) }}"
          onsubmit="return confirm('Supprimer cette tâche ?');"
          style="margin-top: 1rem;">

        <input type="hidden" name="_token"
               value="{{ csrf_token('delete_task_' ~ task.id) }}">

        <button class="delete-task" type="submit">
            Supprimer la tâche
        </button>
    </form>

</div>
{% endblock %}
