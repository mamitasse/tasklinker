{% extends 'base.html.twig' %}

{% block title %}Créer une tâche - TaskLinker{% endblock %}

{% block body %}
<header>
    <div id="current-user"></div>
    <div id="title-page">
        <h1>Créer une tâche</h1>
    </div>
</header>

<div id="content">
    {{ form_start(form) }}

        {{ form_row(form.title) }}
        {{ form_row(form.description) }}

        <div class="flex-form">
            <div>
                {{ form_row(form.deadline) }}
            </div>
            <div>
                {{ form_row(form.status) }}
            </div>
        </div>

        {{ form_row(form.assignee) }}

        <br>
        <button class="button button-submit">Ajouter</button>

    {{ form_end(form) }}
</div>
{% endblock %}
