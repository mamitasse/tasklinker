{% extends 'base.html.twig' %}

{% block title %}Créer une tâche - TaskLinker{% endblock %}

{% block body %}
<header>
<div id="current-user">
    {{ include('_current_user.html.twig') }}
</div>

    <div id="title-page">
        <h1>Créer une tâche</h1>
    </div>
</header>

<div id="content">
    {{ form_start(form) }}

        <div>
            {{ form_label(form.title, 'Titre de la tâche') }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>

        <div>
            {{ form_label(form.description, 'Description') }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="flex-form">
            <div>
                {{ form_label(form.deadline, 'Date') }}
                {{ form_widget(form.deadline) }}
                {{ form_errors(form.deadline) }}
            </div>

            <div>
                {{ form_label(form.status, 'Statut') }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>
        </div>

        <div>
            {{ form_label(form.assignee, 'Membre') }}
            {{ form_widget(form.assignee) }}
            {{ form_errors(form.assignee) }}
        </div>

        <br>

        <button class="button button-submit">Ajouter</button>

    {{ form_end(form) }}
</div>
{% endblock %}
